<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.sklk"
       version="0.0.26"
       name="sklk"
       provider-name="krk">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.simplejson" version="2.0.10"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <!-- reports playback to the server, which keeps watched state for all apps -->
    <extension point="xbmc.service" library="service.py" start="login"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">sklk pluginas</summary>
        <description lang="en_GB">nera jokio aprasymo</description>
        <disclaimer lang="en_GB">cia irgi nieko nera</disclaimer>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
        <news>0.0.26: back in the list after playback again (it was lost: the service refreshed it while Kodi was reloading it). 0.0.25:sending Kodi's watched history to the server is a button in the settings. 0.0.24: watched state and resume points kept on the server, shared with other apps</news>
    </extension>
</addon>
